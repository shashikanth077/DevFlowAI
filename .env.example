# ---------------------------------------------------------------------------
# DevFlow AI configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Security (REQUIRED in production): long random strings, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
# Optional dedicated Fernet key for encrypting stored tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOW_REGISTRATION=true

# Database (docker compose overrides this to point at the postgres service)
DATABASE_URL=postgresql+psycopg://devflow:devflow@localhost:5432/devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_DB=devflow
# auto | postgres | sqlite | memory  (auto = postgres when DATABASE_URL is PostgreSQL)
CHECKPOINT_BACKEND=auto

# LLM provider defaults (each user can override in Settings)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3
LLM_CONTEXT_CHARS=60000
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=

# GitHub. Prefer per-user tokens entered in Settings; this is an optional server-wide fallback.
# Fine-grained PAT permissions: Contents (read/write), Pull requests (read/write), Metadata (read).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
PROTECTED_BRANCH_PATTERNS=main,master,develop,production,release/*
GIT_AUTHOR_NAME=DevFlow AI
GIT_AUTHOR_EMAIL=devflow-ai@users.noreply.github.com

# Workspaces & Docker sandbox
WORKSPACE_ROOT=./workspaces
CLEANUP_WORKSPACES=true
SANDBOX_ENABLED=true
SANDBOX_CPUS=1.0
SANDBOX_MEMORY=1g
SANDBOX_PIDS_LIMIT=512
SANDBOX_COMMAND_TIMEOUT_SECONDS=600
SANDBOX_SETUP_TIMEOUT_SECONDS=900
SANDBOX_ALLOW_NETWORK_FOR_INSTALL=false
SANDBOX_PYTHON_IMAGE=python:3.11-slim
SANDBOX_NODE_IMAGE=node:20-slim
# Group id of /var/run/docker.sock on the host (stat -c %g /var/run/docker.sock)
DOCKER_GID=999

# Workflow policy defaults
WORKFLOW_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=900
WORKFLOW_WORKER_THREADS=4
REQUIRE_EXECUTION_APPROVAL=true
REQUIRE_RELEASE_APPROVAL=true
RESUME_WORKFLOWS_ON_STARTUP=true
